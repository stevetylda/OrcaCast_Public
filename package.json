{
  "name": "orcacast-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:unit && npm run test:component",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium --project=mobile-chromium",
    "build": "tsc -b && vite build",
    "build:check": "npm run build && node scripts/check_bundle_budget.mjs",
    "analyze": "npm run build",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "repo:check": "bash scripts/check_artifacts.sh",
    "data:validate": "npm run validate:data",
    "validate:data": "node scripts/generate-home-summary.mjs --check && node scripts/validate-data.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:build-secrets": "node scripts/check-build-secrets.mjs",
    "tiles:generate:this-week": "python3 scripts/generate_raster_tiles.py --clean",
    "data:home": "node scripts/generate-home-summary.mjs",
    "predev": "npm run data:home",
    "prebuild": "npm run data:home"
  },
  "dependencies": {
    "driver.js": "^1.4.0",
    "geotiff": "^3.0.5",
    "html-to-image": "^1.11.13",
    "maplibre-gl": "^5.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-xml-parser": "^5.10.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
