{
  "name": "orcacast-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:unit && npm run test:component",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium --project=mobile-chromium",
    "build": "tsc -b && vite build",
    "build:check": "npm run build && node scripts/check_bundle_budget.mjs",
    "analyze": "npm run build",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "repo:check": "bash scripts/check_artifacts.sh",
    "data:validate": "npm run validate:data",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:build-secrets": "node scripts/check-build-secrets.mjs",
    "tiles:generate:this-week": "python3 scripts/generate_raster_tiles.py --clean"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "d3-shape": "^3.2.0",
    "driver.js": "^1.4.0",
    "geotiff": "^3.0.5",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.17.0",
    "plotly.js-dist-min": "^2.35.2",
    "pmtiles": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^6.30.0",
    "reactflow": "^11.11.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-shape": "^3.1.8",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-xml-parser": "^5.10.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "npm:rolldown-vite@7.2.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
